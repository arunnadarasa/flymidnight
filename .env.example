# Hosted Midnight stack (Fly.io). Point the dApp at these instead of localhost.
# Provisioned by scripts/fly-bootstrap.sh — change the app names here if you
# used different ones.
VITE_NETWORK_ID=undeployed
# The indexer-standalone v4.0.2 image serves GraphQL on /api/v4/graphql.
# /api/v1/graphql returns a 308 redirect loop on the public fly.dev URL.
VITE_INDEXER_URL=https://choreo-indexer.fly.dev/api/v4/graphql
VITE_INDEXER_WS_URL=wss://choreo-indexer.fly.dev/api/v4/graphql/ws
VITE_PROOF_SERVER_URL=https://choreo-proof.fly.dev
VITE_FAUCET_URL=https://choreo-faucet.fly.dev
# Filled in by scripts/deploy-midnight.mjs after a successful deploy.
VITE_DEFAULT_CONTRACT=d27f543491f863f7ddb40365ad82d7896435253c4ea8728bbf5b6f1478b503d5
VITE_MINT_URL=https://choreo-mint.fly.dev
